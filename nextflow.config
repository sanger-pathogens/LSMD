// Copyright (C) 2026 Genome Research Ltd.

// Config inheritance options
params {
    generic_config_base = "https://raw.githubusercontent.com/sanger-pathogens/nextflow-commons/"
    generic_config_version = "master"
    generic_config_url = ""
}
inherit_generic_config()

manifest {
    name            = '{{pipeline_name}}'
    author          = 'Sahra Musse, PAM Informatics'
    homePage        = '{{pipeline_url}}'
    description     = '{{pipeline_description}}'
    mainScript      = 'main.nf'
    nextflowVersion = '>=21.04.0'
    version         = '{{pipeline_version}}'
    recurseSubmodules = true
}

includeConfig "./assorted-sub-workflows/themisto2/themisto2.config"

params {
    // Logging options
    monochrome_logs = false

    // Output options
    outdir = "./results"

    // Temporary space requested for processes that need it (e.g. GGCAT)
    temp_space = 10000

    // Post-processing (step09) -- filters/masks G (final candidate markers) for
    // PCR/primer-design suitability. Off by default since it's a new, separate
    // step from index-building; the pipeline stops at the checked candidate_markers
    // SBWT index/FASTA unless this is turned on.
    primer_post_processing = false
    // Minimum candidate marker length in bp.
    primer_min_length = 100
    // Global GC%% range a candidate marker's whole sequence must fall within.
    primer_gc_min = 35.0
    primer_gc_max = 60.0
    // Local sliding-window size (bp) for the non-designable-region GC check --
    // defaults to kmer_size (k-mer resolution) rather than a separate constant,
    // since that's the whole reasoning behind the window size choice.
    primer_window_size = params.kmer_size
    // Write rejected (too-short/global-GC-out-of-range) candidates to their own FASTA.
    primer_write_rejected = true
    // Generate the 4-panel length/GC diagnostic plot.
    primer_plot = true

}



// To test the pipeline, you can use the test profile which is defined below. You can run the pipeline with the test profile using the following command:
// nextflow run main.nf -profile test
profiles {
    test {
        params {
            metadata     = "/data/pam/team230/sm71/scratch/gps_project/01_metadata/v_tarriae/v_tarriae_lineage_metadata.csv"
            assembly_input  = "/data/pam/team230/sm71/scratch/gps_project/00_input_genomes/v_tarriae/assemblies"
            assembly_suffix = ".fasta.gz"
            group_label  = "Lineage"
            sample_col      = "name"
            color_index_kmer_size = 31
            // Only lineage present in this test metadata -- same 11 genomes as the
            // species-wide index, but exercises the target_groups/lineage_index/
            // candidate_index code path (COLOR_MAPPING's target_group branch,
            // GGCAT_GROUP/SBWT_*_GROUP, CANDIDATE_FILTER, and the candidate rebuild).
            target_groups = "Vibriotarriae"
        }
    }

// sanger_local profile: increase CPU/memory defaults to handle cpu_32/mem_64 processes.
// Match these values when submitting the outer bsub job (e.g. `bsub.py --threads 32 64 ...`).
    sanger_local {
        params {
            max_cpus   = 32
            max_memory = 64.GB
        }
    }
}



process {
    maxRetries = params.max_retries
    withLabel: request_temp {
        clusterOptions = "-R 'rusage[tmp=${params.temp_space}]'"
    }
}


// Helper functions
def inherit_generic_config() {
    config_url = params.generic_config_url ? params.generic_config_url : "${params.generic_config_base}/${params.generic_config_version}/configs/nextflow.config"
    try {
        includeConfig "${config_url}"
    } catch (Exception e) {
        System.err.println("ERROR: Could not load generic config: ${config_url}")
        System.err.println("Encountered the following exception:")
        throw e
    }
}