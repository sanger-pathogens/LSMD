// Parameters for DESIGN_BAITS (modules/bait_capture.nf) -- BaitsTools `tilebaits`.
//
// NOT included anywhere yet. When the PAT-3581 assay tracks land, either
// `includeConfig` this from nextflow.config or fold the block into it, and add
// the DESIGN_BAITS call to main.nf behind `'bait' in params.assays`.
//
// Values are BaitsTools' own defaults (v1.8.3) unless noted. BaitsTools only
// filters on a criterion when its flag is passed -- the module passes the
// GC / mask / homopolymer / complexity / complete / no-Ns flags always, and the
// Tm flags only when bait_min_tm / bait_max_tm are non-null.

params {
    // --- tiling geometry ---
    bait_length            = 120    // -L  requested bait length (bp)
    bait_offset            = 60     // -O  bp between tiled bait starts (60 = 2x tiling)

    // --- sequence-composition filters ---
    bait_gc_min            = 30.0   // -n  min GC%  (BaitsTools default; PAT-3581 mooted a wider 30-65 window)
    bait_gc_max            = 50.0   // -x  max GC%
    bait_max_mask          = 25.0   // -K  max % soft-masked (lowercase) bases -- consumes step-09 bait-mode masking
    bait_max_homopolymer   = 4      // -J  max homopolymer run
    bait_min_complexity    = 0.9    // -y  min linguistic complexity
    bait_complete          = true   // -c  drop end baits shorter than bait_length
    bait_no_ns             = true   // -N  drop baits containing N

    // --- melting-temperature filter (opt-in: null = not applied) ---
    bait_min_tm            = null   // -q  min Tm (deg C)
    bait_max_tm            = null   // -z  max Tm (deg C)
    bait_hyb_type          = "RNA-DNA"  // -T  hybridisation chemistry (only used if Tm filtering)
    bait_na                = 0.9    // -s  Na+ concentration (M), for Tm
    bait_formamide         = 0.0    // -f  formamide concentration (M), for Tm

    // --- extra outputs ---
    bait_params_table      = true   // -w  per-bait QC table (*-filtered-params.txt)
    bait_bed               = true   // -B  BED of bait coordinates
}
